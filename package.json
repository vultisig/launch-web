{
  "name": "vultisig-feature-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --ext .ts,.tsx,.mjs,.js && node --check api/core.mjs && node --check api/index.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.mjs,.js --fix",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck:api",
    "typecheck:api": "tsc --allowJs --checkJs --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --types node --skipLibCheck api/core.mjs api/index.mjs scripts/api-server.mjs scripts/apply-schema.mjs scripts/dev.mjs shared/featureBoard.js",
    "db:schema": "node scripts/apply-schema.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.90.5",
    "@uniswap/sdk-core": "^7.8.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v3-sdk": "^3.26.0",
    "antd": "^5.27.6",
    "axios": "^1.13.1",
    "dayjs": "^1.11.18",
    "ethers": "^6.15.0",
    "graphql-request": "^7.3.1",
    "highcharts": "^12.4.0",
    "highcharts-react-official": "^3.2.3",
    "i18next": "^25.6.0",
    "i18next-http-backend": "^3.0.2",
    "lodash": "^4.17.21",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^16.2.1",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.9.4",
    "styled-components": "^6.1.19",
    "uuid": "^13.0.0",
    "viem": "^2.38.5",
    "wagmi": "^2.19.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/righteous": "^5.2.7",
    "@fontsource/roboto-mono": "^5.2.8",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.9.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "csstype": "^3.1.3",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "sass": "^1.93.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12"
  }
}
